{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "./worker.ts",
  "name": "quizknight",
  "workers_dev": true,
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "quizknight",
    },
  ],
  "triggers": {
    // Replaces the Netlify scheduled functions + Vercel crons.
    // One trigger (account has a 5-trigger limit), fires 03:00 and 09:00 UTC.
    // worker.ts picks the job by UTC hour: 03 → /api/cleanup, 09 → /api/ping
    "crons": ["0 3,9 * * *"],
  },
  "vars": {
    // NEXT_PUBLIC_* values are also inlined at build time for client code.
    // Set non-secret NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY
    // here or via `wrangler vars` — secrets go through `wrangler secret put`.
    // Sentry DSN is public by design (it ships in the browser bundle).
    "NEXT_PUBLIC_SENTRY_DSN": "https://3e32d1167045b66a67853231e25ce9f1@o4512000811991040.ingest.de.sentry.io/4512278817013840",
  },
}
